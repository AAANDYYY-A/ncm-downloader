<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.operit.ncmdownloader"
    android:versionCode="8"
    android:versionName="1.8">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <application android:label="网易云自动下载" android:hasCode="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light">
        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@android:style/Theme.Material.Light"
            android:label="网易云自动下载">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider android:name=".CurrentProvider"
            android:authorities="com.operit.ncmdownloader.provider"
            android:exported="true" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription" android:value="监听网易云播放自动下载；UI可查看当前歌曲ID、选音质下载、歌单一键下载" />
        <meta-data android:name="xposedminversion" android:value="82" />
    </application>
</manifest>